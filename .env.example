VITE_API_ORIGIN=http://127.0.0.1:5000
VITE_HOSPITAL_CODE=default

# Authenticated browser requests use the same-origin BFF. Server-only auth
# variables belong in .dev.vars or the deployment secret store:
#
#   IDENTITY_ORIGIN=http://127.0.0.1:5000
#   APP_ORIGIN=http://127.0.0.1:5173
#   AUTH_SESSION_SECRET=<32+ characters>
#   AUTH_CLIENT_ID=cynara-web
#   AUTH_CLIENT_SECRET=<client secret>
#
# The Playwright suite reuses IDENTITY_ORIGIN/AUTH_* for its token helper;
# credentials default to the API dev seeder (doctor@cynara.dev).
