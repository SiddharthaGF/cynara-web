# Local-only overrides. Copy to `.env` (gitignored) to override the defaults
# baked into `vite.config.ts`. Each value falls back to the next source:
#
#   1. process env (CI / shell)
#   2. this `.env` file
#   3. the wrangler.toml [vars] block (production only)
#
# Keep this file committed with safe defaults; never commit `.env` itself.

# Public origin of cynara-api used by the client bundle and the SSR worker.
# Default points at the cynara-api dev server on port 5000 (see
# docs/local-development.md). CORS must allow this origin on the API side.
VITE_API_ORIGIN=http://localhost:5000