VITE_API_ORIGIN=https://cynara-api.onrender.com
VITE_HOSPITAL_CODE=default

# CYN-96 disposable auth spike (optional, LOCAL DEV ONLY).
# The client bundle branches on VITE_AUTH_MODE; the SSR worker branches on
# AUTH_MODE from `.dev.vars` / `wrangler.jsonc [vars]` (never here).
# Set both to "spike" only while running against the disposable identity
# spike on http://localhost:5295. Omit for production behavior.
# VITE_AUTH_MODE=spike
# IDENTITY_ORIGIN=http://localhost:5295
