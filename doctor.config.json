{
  "$schema": "https://react.doctor/schema/config.json",
  "ignore": {
    "files": [
      "src/components/ui/**",
      "src/lib/utils.ts",
      "src/hooks/use-mobile.ts",
      "src/api/generated/**",
      "packages/rule-engine/dist/**"
    ],
    "overrides": [
      {
        "files": ["src/api/workflowLifecycle.ts"],
        "rules": ["deslop/unused-file"]
      }
    ]
  }
}
