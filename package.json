  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:keep-vars": "pnpm build && wrangler deploy --keep-vars",
    "dev": "vite dev",
    "doctor": "npx react-doctor@latest",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "precommit": "pnpm lint:check && pnpm typecheck",
    "prepare": "husky",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
