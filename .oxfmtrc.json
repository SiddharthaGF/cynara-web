{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "quoteProps": "consistent",
  "arrowParens": "always",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "singleAttributePerLine": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "always",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    "src/components/ui/**",
    "src/lib/utils.ts",
    "src/hooks/use-mobile.ts",
    "src/api/generated/**",
    "packages/rule-engine/dist/**"
  ]
}
